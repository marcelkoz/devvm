{
    "workbench.colorTheme": "{{ arch_vscode_config_colour_theme }}",
    "terminal.integrated.fontFamily": "{{ arch_vscode_config_font_family }}",
    "terminal.integrated.fontSize": {{ arch_vscode_config_font_size }},
    "editor.fontFamily": "{{ arch_vscode_config_font_family }}",
    "editor.fontSize": {{ arch_vscode_config_font_size }},
    "editor.fontLigatures": true,
    "editor.guides.bracketPairs": true,
    "explorer.confirmDragAndDrop": false,
    "[liquid]": {
        "editor.formatOnSave": false,
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "redhat.telemetry.enabled": false,
    "ansible.lightspeed.enabled": false,
    "docker.extension.enableComposeLanguageServer": false
}